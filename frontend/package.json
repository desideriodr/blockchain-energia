    "@angular/core": "^21.2.6",
    "@angular/forms": "^21.2.6",
    "@angular/platform-browser": "^21.2.6",
    "@angular/router": "^21.2.6",
    "@apollo/client": "^4.0.11",
    "apexcharts": "^5.3.6",
    "apollo-angular": "^13.0.0",
    "graphql": "^16.12.0",
    "ng-apexcharts": "^2.0.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.5",
    "@angular/cli": "^21.2.5",
    "@angular/compiler-cli": "^21.2.6",
    "jsdom": "^27.1.0",
