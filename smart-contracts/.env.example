# ─────────────────────────────────────────────────────────────────────────────
# smart-contracts — variables de entorno
# NUNCA subir este archivo a git (.gitignore ya lo excluye)
# ─────────────────────────────────────────────────────────────────────────────

# URL del nodo RPC para Sepolia (Alchemy)
# Formato: https://eth-sepolia.g.alchemy.com/v2/TU_API_KEY
SEPOLIA_RPC_URL=

# Clave privada del deployer — wallet con SepoliaETH para pagar gas
# Generar con: node -e "const {ethers}=require('ethers'); const w=ethers.Wallet.createRandom(); console.log(w.privateKey)"
# Formato: 0x + 64 caracteres hex
SEPOLIA_PRIVATE_KEY=

# Direccion publica de la wallet del backend (oracle)
# Es el address que corresponde a SEPOLIA_PRIVATE_KEY
# Formato: 0x + 40 caracteres hex
PLATFORM_WALLET=
